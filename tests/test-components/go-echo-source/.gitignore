# Build artefacts.
go_echo_source.wasm
*.wasm

# Generated bindings — regenerated by `wit-bindgen-go` on every build
# via `tests/integration/build.rs`.
internal/

# WIT deps tree — staged at build time by `tests/integration/build.rs`,
# which copies the canonical `torvyn:streaming` WIT from
# `crates/torvyn-contracts/` and the WASI Preview-2 WIT from TinyGo's
# bundle.
wit/deps/

# wkg artefacts (used during local prototyping but not by the
# integration build).
wkg.lock
